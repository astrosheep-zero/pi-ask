{
  "name": "@astrosheep/pi-ask",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrosheep-zero/pi-ask.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Ask-user-question tool for Pi: a tabbed terminal dialog with typed options, recommended markers, and free-text answers",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pi --no-extensions -e ./src/index.ts --list-models __load_check__"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.34",
    "typescript": "^6.0.3"
  }
}
